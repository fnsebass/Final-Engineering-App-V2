    "Used by the Export button (square-and-arrow-up icon) in a notepad's toolbar." : {
      "comment" : "The description of the default export format setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
